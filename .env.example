# -------------------------------------------------------
# Local SQLite database (created automatically, never committed)
# -------------------------------------------------------
DATABASE_URL=sqlite:///retirement.db

# Security: replace with a long random string
SECRET_KEY=change-me

# HTTP Basic Auth passwords for each sample user.
# Leaving a password blank disables that account entirely.
AUTH_STEVEN_PASSWORD=
AUTH_ALYSSA_PASSWORD=
AUTH_GUEST_PASSWORD=

# Failed-login hardening
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_FAILED_WINDOW_SECONDS=300
AUTH_LOCKOUT_SECONDS=900

# Debug mode
DEBUG=false

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8000
